# Hermes Agent config — diatur supaya semua LLM call lewat 9Router lokal.
# File ini di-load dari /root/.hermes/config.yaml.
#
# 9Router jalan di port 20128 dengan format OpenAI-compatible. Hermes pake
# provider "custom" buat ngarahin LLM call ke endpoint ini. API key 9router
# diset via configure-hermes.sh ke /root/.hermes/.env (OPENAI_API_KEY).

model:
  # Combo "free_smart_fallback" dibuat otomatis sama 9router waktu install
  # dengan smart fallback antar provider yang udah lo tambahin
  # (OpenRouter, Groq, Gemini, Cerebras, dll).
  default: "free_smart_fallback"

  # "custom" = OpenAI-compatible endpoint apapun (di sini = 9router lokal)
  provider: "custom"

  # 9router endpoint
  base_url: "http://localhost:20128/v1"

  # Hermes baca API key dari env var OPENAI_API_KEY (di /root/.hermes/.env)
  # Jadi field ini sengaja ga di-set hardcode.
  # api_key: "sk-xxxxx"

# Terminal tool — biar Hermes bisa eksekusi command di VPS lo
terminal:
  backend: "local"
  cwd: "/root"
  timeout: 180
  lifetime_seconds: 300

# Konteks compression — auto-summarize chat panjang biar ga abis token
compression:
  enabled: true
  threshold: 0.50
  protect_last_n: 20

# Persona file — Hermes baca SOUL.md tiap respond
# (default: /root/.hermes/SOUL.md, ga perlu di-set lagi di sini)

# Tools yang dipake di Telegram
platform_toolsets:
  telegram: [hermes-telegram]
  cli: [hermes-cli]

# Kalo sesi udah idle 24 jam, reset (data penting otomatis di-save ke memory)
session_reset:
  mode: both
  idle_minutes: 1440
  at_hour: 4
