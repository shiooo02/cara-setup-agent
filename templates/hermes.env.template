# Hermes (Telegram bot) environment variables.
# File ini di-load oleh systemd service hermes-gateway.
# Lokasi: /root/.hermes/.env

# ---- Telegram ----
# Token dari @BotFather (format: 12345:AAA...)
TELEGRAM_BOT_TOKEN=

# Telegram user ID lo (chat sama @userinfobot buat dapet)
# Pakai TELEGRAM_ALLOWED_USERS biar yang bisa pake bot cuma lo doang.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_OWNER_ID=

# Default chat tempat cron-job kirim hasilnya (biasanya = TELEGRAM_OWNER_ID)
# TELEGRAM_HOME_CHANNEL=

# ---- LLM backend (9Router) ----
# 9Router jalan lokal port 20128.
# Hermes baca API key dari OPENAI_API_KEY ini, terus pake base_url dari
# config.yaml (provider: custom + base_url: http://localhost:20128/v1).
OPENAI_API_KEY=

# ---- Default model dipindah ke config.yaml (model.default) ----
# Kalo mau ganti, edit /root/.hermes/config.yaml atau jalanin:
#   hermes model
