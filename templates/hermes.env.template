# Hermes (Telegram bot) environment variables.
# File ini di-load oleh systemd service hermes.service.
# Jangan ubah path file ini: /root/.hermes/.env

# ---- Telegram ----
# Token dari @BotFather (format: 12345:AAA...)
TELEGRAM_BOT_TOKEN=

# Telegram user ID lo (chat sama @userinfobot buat dapet)
TELEGRAM_OWNER_ID=

# ---- LLM backend (point ke 9Router) ----
# 9Router jalan lokal di port 20128, jadi base URL ini biarin aja.
OPENAI_BASE_URL=http://localhost:20128/v1

# API key dari dashboard 9router (Settings → API Keys → New)
OPENAI_API_KEY=

# Default model. "free_smart_fallback" otomatis pindah model kalau rate-limit.
DEFAULT_MODEL=free_smart_fallback
