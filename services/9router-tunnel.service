[Unit]
Description=9Router Cloudflare Quick Tunnel
After=network-online.target 9router.service
Wants=network-online.target
Requires=9router.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/cloudflared tunnel --url http://localhost:20128 --no-autoupdate
Restart=always
RestartSec=10
StandardOutput=append:/var/log/9router-tunnel.log
StandardError=append:/var/log/9router-tunnel.log

[Install]
WantedBy=multi-user.target
