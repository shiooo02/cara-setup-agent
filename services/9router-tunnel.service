[Unit]
Description=9Router Cloudflare Quick Tunnel
After=network-online.target 9router.service
Wants=network-online.target
Requires=9router.service

[Service]
Type=simple
User=root
# --protocol http2 = jangan pake QUIC/UDP (banyak VPS blokir UDP/7844 → restart loop)
# --no-autoupdate  = jangan ngirim sinyal restart sendiri
ExecStart=/usr/local/bin/cloudflared tunnel --url http://localhost:20128 \
          --protocol http2 --no-autoupdate
Restart=always
RestartSec=10
# Limit restart biar gak infinite loop kalau beneran broken
StartLimitIntervalSec=300
StartLimitBurst=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
