[Unit]
Description=9Router AI Router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/9router
# on-failure (bukan always) biar exit 0 ga nge-trigger restart
Restart=on-failure
RestartSec=15

# --- Restart limit biar gak crash-loop infinite ---
# Maks 5x restart dalam 10 menit, abis itu systemd kasih give-up.
# Kalo terlampaui = pasti ada masalah real (bukan transient), reset-failed manual.
StartLimitIntervalSec=600
StartLimitBurst=5

# --- Memory management (penting di VPS RAM kecil) ---
# Pas first start, 9router compile better-sqlite3 yg bisa butuh ~800MB-1.5GB.
# Naikin limit biar compile bisa finish.
MemoryAccounting=yes
MemoryHigh=1500M
MemoryMax=1800M
OOMScoreAdjust=300

# --- Boot timeout ---
TimeoutStartSec=300

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
